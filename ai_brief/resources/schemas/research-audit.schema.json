{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "真实晨报的私有审计包；不构成发布、合入或投递授权。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "window_hours": {
      "enum": [
        24,
        72,
        168
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "history_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "prompt_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "prompt_hashes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "research.md": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "editor.md": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sources.md": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "delivery.md": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "audit.md": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "research.md",
            "editor.md",
            "sources.md",
            "delivery.md",
            "audit.md"
          ]
        },
        "candidates_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "draft_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "history_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "history_commit",
        "prompt_commit",
        "prompt_hashes",
        "candidates_sha256",
        "draft_sha256",
        "history_sha256"
      ]
    },
    "limits": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,79}$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "maxLength": 4000
          },
          "status": {
            "enum": [
              "ok",
              "failed",
              "timeout",
              "unknown"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "elapsed_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 86400
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "content_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "type": "string",
            "maxLength": 2000
          },
          "timing_unavailable_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "attempt_records": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "enum": [
                    "ok",
                    "failed",
                    "timeout",
                    "unknown"
                  ]
                },
                "elapsed_seconds": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 86400
                },
                "error": {
                  "type": "string",
                  "maxLength": 2000
                },
                "timing_unavailable_reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "pattern": "\\S"
                },
                "reserved_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 3600
                }
              },
              "required": [
                "status",
                "elapsed_seconds",
                "error",
                "reserved_seconds"
              ],
              "oneOf": [
                {
                  "properties": {
                    "elapsed_seconds": {
                      "type": "number"
                    }
                  },
                  "not": {
                    "required": [
                      "timing_unavailable_reason"
                    ]
                  }
                },
                {
                  "properties": {
                    "elapsed_seconds": {
                      "type": "null"
                    }
                  },
                  "required": [
                    "timing_unavailable_reason"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "url",
          "status",
          "attempts",
          "elapsed_seconds",
          "retrieved_at",
          "published_at",
          "content_sha256",
          "error"
        ],
        "oneOf": [
          {
            "properties": {
              "elapsed_seconds": {
                "type": "number"
              }
            },
            "not": {
              "required": [
                "timing_unavailable_reason"
              ]
            }
          },
          {
            "properties": {
              "elapsed_seconds": {
                "type": "null"
              }
            },
            "required": [
              "timing_unavailable_reason"
            ]
          }
        ]
      },
      "maxItems": 500
    },
    "checks": {
      "type": "object"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "disposition": {
            "enum": [
              "selected",
              "update",
              "duplicate",
              "insufficient_evidence",
              "out_of_scope"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,79}$"
            },
            "maxItems": 30
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "history_entry_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "maxItems": 30
          }
        },
        "required": [
          "event_key",
          "disposition",
          "source_ids",
          "reason",
          "history_entry_ids"
        ]
      },
      "maxItems": 500
    },
    "model_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stage": {
            "enum": [
              "research",
              "editor"
            ]
          },
          "status": {
            "enum": [
              "ok",
              "failed",
              "timeout",
              "partial",
              "unknown"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "elapsed_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 86400
          },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "version": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unavailable_reason": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "name",
              "version",
              "unavailable_reason"
            ]
          },
          "error": {
            "type": "string",
            "maxLength": 2000
          },
          "timing_unavailable_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "partial_reason": {
            "const": "coverage_incomplete"
          },
          "attempt_records": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "enum": [
                    "ok",
                    "failed",
                    "timeout",
                    "partial",
                    "unknown"
                  ]
                },
                "elapsed_seconds": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 86400
                },
                "error": {
                  "type": "string",
                  "maxLength": 2000
                },
                "timing_unavailable_reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "pattern": "\\S"
                },
                "input_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "checkpoint_sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "result_sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reserved_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 3600
                },
                "page_round": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "revision",
                    "page_ids",
                    "previous_audit_sha256"
                  ],
                  "properties": {
                    "revision": {
                      "type": "integer",
                      "minimum": 2
                    },
                    "page_ids": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "enum": [
                          "model-serving-gpu",
                          "hardware-status",
                          "model-architecture-status",
                          "embodied-training",
                          "small-model-status",
                          "inference-engines"
                        ]
                      }
                    },
                    "previous_audit_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              },
              "required": [
                "status",
                "elapsed_seconds",
                "error",
                "input_sha256",
                "checkpoint_sha256",
                "result_sha256",
                "reserved_seconds"
              ],
              "oneOf": [
                {
                  "properties": {
                    "elapsed_seconds": {
                      "type": "number"
                    }
                  },
                  "not": {
                    "required": [
                      "timing_unavailable_reason"
                    ]
                  }
                },
                {
                  "properties": {
                    "elapsed_seconds": {
                      "type": "null"
                    }
                  },
                  "required": [
                    "timing_unavailable_reason"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "stage",
          "status",
          "attempts",
          "elapsed_seconds",
          "model",
          "error"
        ],
        "oneOf": [
          {
            "properties": {
              "elapsed_seconds": {
                "type": "number"
              }
            },
            "not": {
              "required": [
                "timing_unavailable_reason"
              ]
            }
          },
          {
            "properties": {
              "elapsed_seconds": {
                "type": "null"
              }
            },
            "required": [
              "timing_unavailable_reason"
            ]
          }
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "partial"
                }
              }
            },
            "then": {
              "properties": {
                "stage": {
                  "const": "research"
                },
                "error": {
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "partial_reason"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "partial_reason"
                ]
              }
            }
          }
        ]
      },
      "maxItems": 2
    },
    "status_entries": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,79}$"
            },
            "maxItems": 30,
            "minItems": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          }
        },
        "required": [
          "event_key",
          "source_ids",
          "reason"
        ]
      }
    },
    "scope": {
      "const": "new_daily"
    },
    "coverage_policy": {
      "enum": [
        "strict",
        "publish_verified_with_gaps"
      ]
    },
    "coverage_notice": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "checks": {
              "type": "array",
              "items": {
                "enum": [
                  "model_serving",
                  "hardware",
                  "model_architecture",
                  "embodied_training",
                  "small_models",
                  "inference_engines",
                  "vllm",
                  "sglang",
                  "deepinfer",
                  "vllm_blog",
                  "sglang_blog",
                  "lmsys_blog",
                  "deepseek_articles",
                  "deepinfer_articles",
                  "glm_blog",
                  "qwen_blog",
                  "glm_models",
                  "deepseek_models",
                  "qwen_models"
                ]
              },
              "minItems": 1,
              "maxItems": 19,
              "uniqueItems": true
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180,
              "pattern": "\\S"
            }
          },
          "required": [
            "checks",
            "text"
          ]
        }
      ]
    },
    "coverage_contract": {
      "const": "daily_required_v1"
    },
    "budget_policy": {
      "const": "successful_work_hourly_continuation_v1"
    },
    "page_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "page_delivery",
        "checked_pages",
        "previous_evidence"
      ],
      "properties": {
        "contract": {
          "const": "verified_pages_v1"
        },
        "page_delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "previous",
            "added",
            "pending"
          ],
          "properties": {
            "previous": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "request_id",
                    "bundle_sha256"
                  ],
                  "properties": {
                    "request_id": {
                      "type": "string",
                      "pattern": "^morning-[0-9]{8}-r[1-9][0-9]*$"
                    },
                    "bundle_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              ]
            },
            "added": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "model-serving-gpu",
                  "hardware-status",
                  "model-architecture-status",
                  "embodied-training",
                  "small-model-status",
                  "inference-engines"
                ]
              }
            },
            "pending": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "reason"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "enum": [
                      "model-serving-gpu",
                      "hardware-status",
                      "model-architecture-status",
                      "embodied-training",
                      "small-model-status",
                      "inference-engines"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "checked_pages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "model-serving-gpu",
              "hardware-status",
              "model-architecture-status",
              "embodied-training",
              "small-model-status",
              "inference-engines"
            ]
          }
        },
        "previous_evidence": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "request_id",
                "bundle_sha256",
                "audit_sha256",
                "archive_sha256",
                "report_commit"
              ],
              "properties": {
                "request_id": {
                  "type": "string",
                  "pattern": "^morning-[0-9]{8}-r[1-9][0-9]*$"
                },
                "bundle_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "audit_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "archive_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "report_commit": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "research_previous": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "request_id",
                    "bundle_sha256",
                    "audit_sha256",
                    "archive_sha256",
                    "report_commit"
                  ],
                  "properties": {
                    "request_id": {
                      "type": "string",
                      "pattern": "^morning-[0-9]{8}-r[1-9][0-9]*$"
                    },
                    "bundle_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "audit_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "archive_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "report_commit": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "required": [
    "schema_version",
    "date",
    "as_of",
    "started_at",
    "finished_at",
    "window_hours",
    "inputs",
    "limits",
    "sources",
    "checks",
    "decisions",
    "model_calls",
    "status_entries",
    "scope"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "properties": {
          "sources": {
            "items": {
              "properties": {
                "elapsed_seconds": {
                  "type": "number"
                }
              },
              "not": {
                "required": [
                  "timing_unavailable_reason"
                ]
              }
            }
          },
          "model_calls": {
            "items": {
              "properties": {
                "elapsed_seconds": {
                  "type": "number"
                }
              },
              "not": {
                "required": [
                  "timing_unavailable_reason"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "1.2",
              "1.3",
              "1.4"
            ]
          }
        }
      },
      "then": {
        "required": [
          "coverage_policy",
          "coverage_notice"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "coverage_policy"
              ]
            },
            {
              "required": [
                "coverage_notice"
              ]
            }
          ]
        },
        "properties": {
          "model_calls": {
            "items": {
              "properties": {
                "status": {
                  "enum": [
                    "ok",
                    "failed",
                    "timeout"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "1.3",
              "1.4"
            ]
          }
        }
      },
      "then": {
        "required": [
          "coverage_contract"
        ],
        "properties": {
          "checks": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "model_serving",
                "hardware",
                "model_architecture",
                "embodied_training",
                "small_models",
                "inference_engines",
                "vllm",
                "sglang",
                "deepinfer",
                "vllm_blog",
                "sglang_blog",
                "lmsys_blog",
                "deepseek_articles",
                "deepinfer_articles",
                "glm_blog",
                "qwen_blog",
                "glm_models",
                "deepseek_models",
                "qwen_models"
              ]
            },
            "required": [
              "model_serving",
              "hardware",
              "model_architecture",
              "embodied_training",
              "small_models",
              "inference_engines",
              "vllm",
              "sglang",
              "deepinfer",
              "vllm_blog",
              "sglang_blog",
              "lmsys_blog",
              "deepseek_articles",
              "deepinfer_articles",
              "glm_blog",
