{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "mode": {
      "enum": [
        "mock",
        "live"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "topic": {
            "enum": [
              "model_serving",
              "manufacturing_embodied_training",
              "other_ai_infra"
            ]
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "source_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source_type": {
            "enum": [
              "primary",
              "secondary"
            ]
          },
          "verification": {
            "enum": [
              "verified",
              "mock_unverified"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "relevance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "limitations": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000,
            "description": "只写影响选型的具体限制，并紧邻对应结论；没有实质限制时留空，不使用统一免责声明。"
          }
        },
        "required": [
          "event_key",
          "title",
          "topic",
          "published_at",
          "retrieved_at",
          "source_url",
          "source_name",
          "source_type",
          "verification",
          "evidence",
          "summary",
          "relevance",
          "limitations"
        ]
      },
      "maxItems": 500
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 100
    }
  },
  "required": [
    "schema_version",
    "mode",
    "items",
    "notes"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "mock"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "verification": {
                  "const": "mock_unverified"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "live"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "properties": {
                "verification": {
                  "const": "verified"
                }
              }
            }
          }
        }
      }
    }
  ]
}
